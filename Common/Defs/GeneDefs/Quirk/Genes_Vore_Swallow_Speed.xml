        <displayCategory>RV2_Vore_General</displayCategory>
        <displayOrderInCategory>3</displayOrderInCategory>
        <biostatMet>0</biostatMet>
        <biostatCpx>0</biostatCpx>
    </GeneDef>

    <GeneDef>
        <defName>RV2_Gene_QuirkForce_SwallowSpeed_Bad</defName>
        <label>Slow eater</label>
        <description>This pawn takes prey in at a leisurely pace, half as quick as other predators.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
        <iconPath>UI/Icons/Genes/SwallowSpeed/2</iconPath>
        <modExtensions>
