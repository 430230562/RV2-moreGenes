            </li>
        </modExtensions>
        <exclusionTags>
            <li>SwallowSpeed</li>
        </exclusionTags>
        <displayCategory>RV2_Vore_General</displayCategory>
        <displayOrderInCategory>2</displayOrderInCategory>
        <biostatMet>0</biostatMet>
    </GeneDef>

    <GeneDef>
        <defName>RV2_Gene_QuirkForce_SwallowSpeed_Normal</defName>
        <label>Normal swallow speed</label>
        <description>This pawn swallows prey at an average speed.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
        <iconPath>UI/Icons/Genes/SwallowSpeed/3</iconPath>
        <modExtensions>
            <li Class="RimVore2.GeneDefExtension_ForcedHediff">
