        <displayOrderInCategory>4</displayOrderInCategory>
        <biostatMet>0</biostatMet>
    </GeneDef>

    <GeneDef>
        <defName>RV2_Gene_QuirkForce_SwallowSpeed_VeryBad</defName>
        <label>Lollygagger</label>
        <description>This pawn has to devour prey real slowly, at about a quarter the speed of other
            predators, lest its body reject its prey.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
