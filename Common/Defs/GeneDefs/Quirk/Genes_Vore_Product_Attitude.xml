<?xml version="1.0" encoding="utf-8"?>

<!-- 这不是一个高效的方法 -->
<Defs>

    <!-- ==================== Vore Product Preferences ==================== -->
    <GeneDef>
        <defName>RV2_Gene_QuirkForce_ProductPreference_Loves</defName>
        <label>Processed pawn connoisseur</label>
        <description>This pawn loves to consume the treats dispensed by predators, who have so
            skillfully churned their prey into thick batter and creamy milk.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
        <iconPath>UI/Icons/Genes/ProductPreference/18</iconPath>
        <modExtensions>
            <li Class="RimVore2.GeneDefExtension_ForcedHediff">
                <hediffs>
                    <li>RV2_Hediff_QuirkForce_ProductPreference_Loves</li>
                </hediffs>
                <removeHediffsOnGeneRemoval>true</removeHediffsOnGeneRemoval>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>ProductPreference</li>
        </exclusionTags>
        <displayCategory>RV2_Vore_General</displayCategory>
        <displayOrderInCategory>18</displayOrderInCategory>
        <biostatMet>0</biostatMet>
    </GeneDef>

    <GeneDef>
        <defName>RV2_Gene_QuirkForce_ProductPreference_Likes</defName>
        <label>Processed pawn taste</label>
