<?xml version="1.0" encoding="utf-8"?>
<Defs> 
    <!-- ==================== Internal Temperature ==================== -->
    <!-- 温度从高到低排列：Scorching (1000°C), Hot (60°C), Warm (40°C), Normal (~37°C), Cold (12°C), Freezing (0°C), AbsoluteZero (-273°C) -->

    <GeneDef>
        <defName>RV2_Gene_QuirkForce_InternalTemperature_Scorching</defName>
        <label>Scorching</label>
        <description>This pawn's insides are extremely hot (1000°C / 1832°F), any prey inside will be instantly cooked.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
        <iconPath>UI/Icons/Genes/InternalTemperature/7</iconPath>
        <modExtensions>
            <li Class="RimVore2.GeneDefExtension_ForcedHediff">
                <hediffs>
                    <li>RV2_Hediff_QuirkForce_InternalTemperature_Scorching</li>
                </hediffs>
                <removeHediffsOnGeneRemoval>true</removeHediffsOnGeneRemoval>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>InternalTemperature</li>
        </exclusionTags>
        <displayCategory>RV2_Vore_General</displayCategory>
        <displayOrderInCategory>7</displayOrderInCategory>
        <biostatMet>0</biostatMet>
        <biostatArc>2</biostatArc>
    </GeneDef>

