        <displayOrderInCategory>8</displayOrderInCategory>
        <biostatMet>0</biostatMet>
    </GeneDef>

    <GeneDef>
        <defName>RV2_Gene_QuirkForce_ItemDamage_FiberFriendly</defName>
        <label>Fiber-friendly digestion</label>
        <description>This pawn's digestive system isn't all that harsh on clothing and other accessories its gurgled prey might have. That's not to say that they'll come out completely unscathed, however.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
        <iconPath>UI/Icons/Genes/ItemDamage/9</iconPath>
        <modExtensions>
