        <displayOrderInCategory>9</displayOrderInCategory>
        <biostatMet>0</biostatMet>
    </GeneDef>

    <GeneDef>
        <defName>RV2_Gene_QuirkForce_ItemDamage_Spotless</defName>
        <label>Spotless digestion</label>
        <description>This pawn has such a clean and purpose-driven digestive system that it can digest prey clean out of their clothes, leaving such vestments not only undamaged, but just as spotless as when they were donned. The same goes for implants and so on.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
        <iconPath>UI/Icons/Genes/ItemDamage/10</iconPath>
        <modExtensions>
