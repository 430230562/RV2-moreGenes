        <!-- ==================== Item Damage ==================== -->
    <GeneDef>
        <defName>RV2_Gene_QuirkForce_ItemDamage_Default</defName>
        <label>Normal item damage</label>
        <description>This pawn damages clothing and implants to a normal degree. The stomach wasn't necessarily designed to digest tough fiber and machined plasteel, but neither were clothes and delicate mechanisms necessarily designed to survive a long acid bath.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
        <iconPath>UI/Icons/Genes/ItemDamage/6</iconPath>
        <modExtensions>
            <li Class="RimVore2.GeneDefExtension_ForcedHediff">
                <hediffs>
                    <li>RV2_Hediff_QuirkForce_ItemDamage_Default</li>
                </hediffs>
                <removeHediffsOnGeneRemoval>true</removeHediffsOnGeneRemoval>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>ItemDamage</li>
        </exclusionTags>
        <displayCategory>RV2_Vore_Digestion</displayCategory>
        <displayOrderInCategory>6</displayOrderInCategory>
        <biostatMet>0</biostatMet>
        <biostatCpx>0</biostatCpx>
        <hidden>true</hidden>
    </GeneDef>

    <GeneDef>
        <defName>RV2_Gene_QuirkForce_ItemDamage_Traceless</defName>
        <label>Traceless digestion</label>
        <description>This pawn leaves no trace of its prey when it is done digesting. Clothing, implants, power armor? It all turns to mush, if anything at all.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
        <iconPath>UI/Icons/Genes/ItemDamage/7</iconPath>
        <modExtensions>
            <li Class="RimVore2.GeneDefExtension_ForcedHediff">
