                    <li>RV2_Hediff_QuirkForce_ItemDamage_Traceless</li>
                </hediffs>
                <removeHediffsOnGeneRemoval>true</removeHediffsOnGeneRemoval>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>ItemDamage</li>
        </exclusionTags>
        <displayCategory>RV2_Vore_Digestion</displayCategory>
        <displayOrderInCategory>7</displayOrderInCategory>
        <biostatMet>0</biostatMet>
    </GeneDef>

    <GeneDef>
        <defName>RV2_Gene_QuirkForce_ItemDamage_Moth</defName>
        <label>Mothlike digestion</label>
        <description>This pawn has a habit of melting the clothes and prosthetics off its prey when digesting them. Their innards are just so harsh on such petty accessories.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
        <iconPath>UI/Icons/Genes/ItemDamage/8</iconPath>
        <modExtensions>
