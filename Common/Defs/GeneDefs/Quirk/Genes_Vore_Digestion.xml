        <displayOrderInCategory>10</displayOrderInCategory>
        <biostatMet>0</biostatMet>
    </GeneDef>

    <!-- ==================== Inabilities ==================== -->
    <GeneDef>
        <defName>RV2_Gene_QuirkForce_Inability_PredEndoOnly</defName>
        <label>Unacerbic</label>
        <description>This pawn can't digest anyone--not alive, at least. It has the stretchiness to swallow prey, but none of the acidity to melt them. For nutrition, it has to settle for normal food instead.</description>
