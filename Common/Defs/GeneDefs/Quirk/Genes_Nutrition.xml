<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- ==================== Nutrition Efficiency (Predator) ==================== -->
    <GeneDef>
        <defName>RV2_Gene_QuirkForce_NutritionEfficiency_Godlike</defName>
        <label>Godlike Efficiency</label>
        <description>Is it magic? Archotech implants? Who knows! At the end of the day, all that
            really matters is that this pawn is capable of feeding or fertilizing an entire colony
            on its own.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
        <iconPath>UI/Icons/Genes/NutritionEfficiency/1</iconPath>
        <modExtensions>
            <li Class="RimVore2.GeneDefExtension_ForcedHediff">
                <hediffs>
                    <li>RV2_Hediff_QuirkForce_NutritionEfficiency_Godlike</li>
                </hediffs>
                <removeHediffsOnGeneRemoval>true</removeHediffsOnGeneRemoval>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>NutritionEfficiency</li>
        </exclusionTags>
        <displayCategory>RV2_Vore_Digestion</displayCategory>
        <displayOrderInCategory>11</displayOrderInCategory>
        <biostatMet>0</biostatMet>
    </GeneDef>

    <GeneDef>
        <defName>RV2_Gene_QuirkForce_NutritionEfficiency_VeryGood</defName>
        <label>Industrial efficiency</label>
        <description>This pawn is about twice as efficient at gaining nourishment and producing
            materials from prey as other predators. It uses the whole muffalo.</description>
