<?xml version="1.0" encoding="utf-8"?>

<!-- Swallowing Speed Quirk Hediffs -->
<Defs>

    <HediffDef ParentName="RV2_VoreEnabledPart_Base">
        <defName>RV2_Hediff_QuirkForce_Cheat_InstantSwallow</defName>
        <label>Instant Swallow</label>
        <description>[PAWN_label] inhales prey like [PAWN_pronoun]'s drowning and the prey are air.</description>
        <comps>
            <li Class="RimVore2.HediffCompProperties_QuirkForcer">
                <quirks>
                    <li>Cheat_InstantSwallow</li>
                </quirks>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="RV2_VoreEnabledPart_Base">
        <defName>RV2_Hediff_QuirkForce_SwallowSpeed_VeryGood</defName>
        <label>Speed-slurper</label>
        <description>This pawn belts down prey at about four times the speed of other predators. It could dominate a prey-swallowing contest.</description>
        <comps>
            <li Class="RimVore2.HediffCompProperties_QuirkForcer">
                <quirks>
                    <li>SwallowSpeed_VeryGood</li>
                </quirks>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="RV2_VoreEnabledPart_Base">
        <defName>RV2_Hediff_QuirkForce_SwallowSpeed_Good</defName>
        <label>Quick eater</label>
        <description>This pawn puts prey away quickly, at about twice the speed of other predators.</description>
        <comps>
            <li Class="RimVore2.HediffCompProperties_QuirkForcer">
                <quirks>
                    <li>SwallowSpeed_Good</li>
                </quirks>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="RV2_VoreEnabledPart_Base">
        <defName>RV2_Hediff_QuirkForce_SwallowSpeed_Normal</defName>
        <label>Normal swallow speed</label>
        <description>This pawn swallows prey at an average speed.</description>
        <comps>
            <li Class="RimVore2.HediffCompProperties_QuirkForcer">
                <quirks>
                    <li>SwallowSpeed_Normal</li>
                </quirks>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="RV2_VoreEnabledPart_Base">
        <defName>RV2_Hediff_QuirkForce_SwallowSpeed_Bad</defName>
        <label>Slow eater</label>
        <description>This pawn takes prey in at a leisurely pace, half as quick as other predators.</description>
        <comps>
            <li Class="RimVore2.HediffCompProperties_QuirkForcer">
                <quirks>
                    <li>SwallowSpeed_Bad</li>
                </quirks>
            </li>
        </comps>
    </HediffDef>

    <HediffDef ParentName="RV2_VoreEnabledPart_Base">
        <defName>RV2_Hediff_QuirkForce_SwallowSpeed_VeryBad</defName>
        <label>Lollygagger</label>
        <description>This pawn has to devour prey real slowly, at about a quarter the speed of other predators, lest its body reject its prey.</description>
        <comps>
            <li Class="RimVore2.HediffCompProperties_QuirkForcer">
                <quirks>
                    <li>SwallowSpeed_VeryBad</li>
                </quirks>
            </li>
        </comps>
    </HediffDef>

</Defs>