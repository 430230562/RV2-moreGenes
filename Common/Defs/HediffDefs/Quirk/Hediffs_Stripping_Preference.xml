<!-- 这不是一个高效的方法 -->
<Defs>
    <!-- ==================== Stripping Preference (Predator) ==================== -->
    <GeneDef>
        <defName>RV2_Gene_QuirkForce_StrippingPreference_Predator_MothTongue</defName>
        <label>Moth's tongue</label>
        <description>This pawn prefers the taste of fabric to skin (whether or not it actually enjoys fabric), and will keep its prey in whatever garb they come.</description>
        <geneClass>RimVore2.Gene_ForcedHediff</geneClass>
        <iconPath>UI/Icons/Genes/StrippingPreference_Predator/6</iconPath>
        <modExtensions>
            <li Class="RimVore2.GeneDefExtension_ForcedHediff">
                <hediffs>
                    <li>RV2_Hediff_QuirkForce_StrippingPreference_Predator_MothTongue</li>
                </hediffs>
                <removeHediffsOnGeneRemoval>true</removeHediffsOnGeneRemoval>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>StrippingPreference_Predator</li>
        </exclusionTags>
        <displayCategory>RV2_Vore_Predator_Preference</displayCategory>
        <displayOrderInCategory>86</displayOrderInCategory>
        <biostatMet>0</biostatMet>
    </GeneDef>

